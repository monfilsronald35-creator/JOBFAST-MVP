# JOBFAST API Gateway — environment variables
# Copy to .env and fill in real values

NODE_ENV=development
GATEWAY_PORT=8080

# Backend service URL (internal Docker hostname in production)
BACKEND_URL=http://localhost:5000

# Must match JWT_SECRET in backend/.env
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-here

# Service-to-service token (generate: openssl rand -hex 32)
INTERNAL_TOKEN=your-internal-service-token-here

# Redis
REDIS_URL=redis://localhost:6379

# CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,https://jobfast.ht

# Logging
LOG_LEVEL=info

# Security: comma-separated IPs/CIDRs to block
BLOCKED_IPS=
BLOCKED_COUNTRIES=

# Limits
MAX_BODY_SIZE_MB=10
DDOS_THRESHOLD=2000
DDOS_WINDOW_MS=60000
CACHE_DEFAULT_TTL=30
