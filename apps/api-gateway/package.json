  },
  "devDependencies": {
    "@types/express":      "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node":         "^22.10.7",
    "tsx":                 "^4.19.2",
    "typescript":          "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  },
