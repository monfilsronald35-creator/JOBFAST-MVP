{
  "name": "jobfast-api-gateway",
  "version": "1.0.0",
  "description": "JOBFAST Global Enterprise API Gateway — Enterprise Edge Platform",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev":       "tsx watch src/server.ts",
