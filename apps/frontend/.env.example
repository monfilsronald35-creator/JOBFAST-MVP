# ============================================================
# JOBFAST FRONTEND — Environment Variables (Vite)
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
# SECURITY RULE: Every variable here is VISIBLE IN THE BROWSER.
# Never put secrets, service-role keys, or private API keys here.
# Secrets belong in the backend .env only.
# ============================================================

# ── Backend ───────────────────────────────────────────────────────────────────
# Base URL of the JOBFAST backend API (include /api/v1 suffix)
VITE_API_URL=http://localhost:5000/api/v1

# WebSocket server URL (Socket.IO — usually same host as API, no /api/v1 suffix)
VITE_SOCKET_URL=http://localhost:5000

# ── Supabase (anon key only — NEVER the service_role key) ────────────────────
# These are safe to expose in the browser (anon key is public by design).
# RLS policies protect data at the database level.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Maps ─────────────────────────────────────────────────────────────────────
# Google Maps / Leaflet tile provider (optional — Leaflet OSM is free default)
VITE_GOOGLE_MAPS_KEY=

# ── Push Notifications (client VAPID public key) ─────────────────────────────
# Public key only — the private key stays on the backend
VITE_VAPID_PUBLIC_KEY=

# ── Production overrides (set these in Vercel / hosting env vars) ────────────
# VITE_API_URL=https://jobfast-backend.onrender.com/api/v1
# VITE_SOCKET_URL=https://jobfast-backend.onrender.com
# VITE_SUPABASE_URL=https://your-project.supabase.co
