{
  "semi": true,
  "singleQuote": true,
  "jsxSingleQuote": false,
  "trailingComma": "all",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "bracketSpacing": true,
  "bracketSameLine": false,
  "arrowParens": "always",
  "endOfLine": "lf",
  "proseWrap": "preserve",
  "overrides": [
    {
      "files": ["*.json", "*.jsonc"],
      "options": { "printWidth": 120 }
    },
    {
      "files": ["*.md"],
      "options": { "proseWrap": "always", "printWidth": 80 }
    },
    {
      "files": ["*.css", "*.scss"],
      "options": { "singleQuote": false }
    }
  ]
}