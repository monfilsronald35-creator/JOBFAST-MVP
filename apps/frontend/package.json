{
  "name": "jobfast-frontend",
  "version": "1.0.0",
  "description": "JOBFAST GLOBAL FRONTEND - Enterprise Platform v4.0",
  "private": true,
  "type": "module",
  "main": "index.html",
  "scripts": {
    "dev": "vite",
    "host": "vite --host",
    "clean": "rimraf dist",
    "prebuild": "npm run clean",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx,.js,.jsx --max-warnings 50",
    "lint:fix": "eslint src --ext .ts,.tsx,.js,.jsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.51.0",
    "@tanstack/react-virtual": "^3.8.0",
    "axios": "^1.7.2",
    "clsx": "^2.1.1",
    "framer-motion": "^11.3.0",
    "i18next": "^26.3.4",
    "leaflet": "^1.9.4",
    "libphonenumber-js": "^1.13.9",
    "localforage": "^1.10.0",
    "lodash": "^4.18.1",
    "lucide-react": "^0.400.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-error-boundary": "^4.0.13",
    "react-hook-form": "^7.83.0",
    "react-i18next": "^17.0.8",
    "react-intersection-observer": "^9.16.0",
    "react-leaflet": "^5.0.0",
    "react-responsive": "^10.0.0",
    "react-router-dom": "^6.26.0",
    "react-virtualized-auto-sizer": "^1.0.24",
    "react-window": "^1.8.10",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^2.3.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@playwright/test": "^1.46.0",
    "@storybook/addon-a11y": "^8.2.0",
    "@storybook/addon-essentials": "^8.2.0",
    "@storybook/addon-interactions": "^8.2.0",
    "@storybook/addon-links": "^8.2.0",
    "@storybook/react-vite": "^8.2.0",
    "@storybook/test": "^8.2.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/leaflet": "^1.9.14",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/react-window": "^1.8.8",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^2.0.0",
    "@vitest/ui": "^2.0.0",
    "autoprefixer": "^10.5.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-import-resolver-typescript": "^3.6.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-jsx-a11y": "^6.9.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "husky": "^9.0.0",
    "jsdom": "^25.0.0",
    "lint-staged": "^15.0.0",
    "postcss": "^8.5.15",
    "prettier": "^3.3.0",
    "rimraf": "^6.0.1",
    "sharp": "^0.35.3",
    "storybook": "^8.2.0",
    "tailwindcss": "^3.4.17",
    "terser": "^5.48.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.2",
    "vitest": "^2.0.0"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix --max-warnings 50",
      "prettier --write"
    ],
    "src/**/*.{js,jsx}": [
      "prettier --write"
    ],
    "src/**/*.{css,json}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "jobfast",
    "frontend",
    "react",
    "vite",
    "typescript",
    "enterprise"
  ],
  "author": "Monfils Ronald",
  "license": "MIT"
}
