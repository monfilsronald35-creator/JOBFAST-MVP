# ============================================================
# JOBFAST API — Staging Environment Variables
# Pipeline: local → development → qa → STAGING → production
# Staging mirrors production config with staging-only domains.
# NEVER commit .env to version control.
# ============================================================

NODE_ENV=staging
PORT=5000

# Staging domains (mirror of production, separate infrastructure)
ALLOWED_ORIGINS=https://staging.jobfasthq.com,https://staging-app.jobfasthq.com

# Security (staging-specific secrets — different from production)
JWT_SECRET=STAGING_CHANGE_ME_MINIMUM_64_CHARS_RANDOM_HEX
ENCRYPTION_KEY=STAGING_CHANGE_ME_32_CHAR_HEX

# Supabase (use a separate staging project, never share with production)
SUPABASE_URL=https://YOUR_STAGING_PROJECT_REF.supabase.co
SUPABASE_SERVICE_KEY=YOUR_STAGING_SERVICE_ROLE_KEY
SUPABASE_ANON_KEY=YOUR_STAGING_ANON_KEY

# Stripe (always use TEST keys on staging — never live keys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_test_...

# Web Push
VAPID_PUBLIC_KEY=YOUR_STAGING_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=YOUR_STAGING_VAPID_PRIVATE_KEY
VAPID_EMAIL=mailto:dev@jobfasthq.com

# AI (optional on staging)
OPENAI_API_KEY=sk-...

# Rate limiting (more permissive on staging for testing)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=500

# Admin
ADMIN_EMAILS=dev@jobfasthq.com,qa@jobfasthq.com