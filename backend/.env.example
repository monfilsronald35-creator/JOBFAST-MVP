# ============================================================
# JOBFAST BACKEND — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=JOBFAST
APP_VERSION=4.0.0
APP_STAGE=development          # development | staging | production

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
API_PREFIX=/api/v1

# ── Security ──────────────────────────────────────────────────────────────────
# CHANGE THESE before deploying to production.
# JWT_SECRET must be at least 32 random characters.
JWT_SECRET=change-me-to-a-long-random-string-minimum-32-chars
ENCRYPTION_KEY=change-me-32-char-hex-key-exactly-32
BCRYPT_SALT_ROUNDS=12

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins. Use * only in local dev (never in prod).
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ── Admin Access ──────────────────────────────────────────────────────────────
# Comma-separated emails that receive the admin role on login.
ADMIN_EMAILS=monfilsronald35@gmail.com

# ── Supabase ──────────────────────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# WARNING: NEVER expose SERVICE_ROLE_KEY in frontend code or VITE_ variables.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ── Database (direct connection — optional, Supabase client is primary) ───────
DATABASE_URL=postgres://postgres:[password]@db.[project].supabase.co:5432/postgres

# ── AI — Anthropic ────────────────────────────────────────────────────────────
# Required for: AI Assistant, Matching, Pricing, Insights, Translation
ANTHROPIC_API_KEY=sk-ant-...

# ── Payments — Stripe ─────────────────────────────────────────────────────────
# Required for: card payments, subscriptions
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Payments — MonCash (Haiti) ────────────────────────────────────────────────
MONCASH_CLIENT_ID=
MONCASH_CLIENT_SECRET=
MONCASH_ENV=sandbox            # sandbox | production

# ── Payments — NatCash (Haiti) ────────────────────────────────────────────────
NATCASH_MERCHANT_ID=
NATCASH_API_KEY=
NATCASH_ENV=sandbox

# ── Email — SendGrid ──────────────────────────────────────────────────────────
# Required for: email notifications, password reset, invoices
SENDGRID_API_KEY=SG....
SENDGRID_FROM_EMAIL=monfilsronald35@gmail.com
SENDGRID_FROM_NAME=JOBFAST

# ── SMS — Twilio ──────────────────────────────────────────────────────────────
# Required for: OTP, SMS notifications
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1...

# ── Push Notifications (Web Push / VAPID) ─────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:monfilsronald35@gmail.com

# ── Maps ──────────────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=

# ── Storage ───────────────────────────────────────────────────────────────────
# Supabase Storage is primary. These are for custom S3-compatible if needed.
STORAGE_BUCKET=jobfast-media
STORAGE_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── Redis (optional cache layer) ──────────────────────────────────────────────
# If not set, in-memory Map cache is used (suitable for single-instance dev).
REDIS_URL=redis://localhost:6379

# ── Feature Flags ─────────────────────────────────────────────────────────────
FEATURE_MARKETPLACE=true
FEATURE_SERVICES=true
FEATURE_AI=true
FEATURE_MONETIZATION=false     # Set true when ready to charge users

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_MAX=100             # requests per 15 min window per IP
MAX_RADIUS_KM=50               # max geo search radius

# ── Localization ──────────────────────────────────────────────────────────────
DEFAULT_COUNTRY=HT
DEFAULT_CURRENCY=HTG
DEFAULT_LANGUAGE=ht

# ── Production overrides (set in Render env vars, not in this file) ───────────
# APP_STAGE=production
# CORS_ORIGIN=https://jobfast-mvp-spzy.vercel.app
# NODE_ENV=production
