# ============================================================
# JOBFAST API — Production Environment Variables
# Copy to .env on the production server. NEVER commit .env.
# All secrets must be rotated before first deploy.
#
# Environment Pipeline:
#   local → development → qa → staging → production
#   Never test directly on Production.
# ============================================================

# ── Application ──────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ── Domain Architecture ───────────────────────────────────────
# Primary domain: jobfasthq.com
# API:            api.jobfasthq.com
# Auth:           auth.jobfasthq.com
# Wallet:         wallet.jobfasthq.com
# Media/CDN:      media.jobfasthq.com
# Chat:           chat.jobfasthq.com
# Search:         search.jobfasthq.com
# AI:             ai.jobfasthq.com
# Maps:           maps.jobfasthq.com
# Notifications:  notify.jobfasthq.com
# Gateway:        gateway.jobfasthq.com

# Comma-separated list of allowed CORS origins (no trailing slash)
ALLOWED_ORIGINS=https://jobfasthq.com,https://app.jobfasthq.com,https://www.jobfasthq.com

# ── Security ─────────────────────────────────────────────────
# Minimum 64 random characters — generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_MINIMUM_64_CHARS_RANDOM_HEX
# 32-byte AES-256 key — generate with: openssl rand -hex 16
ENCRYPTION_KEY=CHANGE_ME_32_CHAR_HEX

# ── Supabase (PostgreSQL) ─────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_KEY=YOUR_SERVICE_ROLE_KEY_KEEP_SECRET
SUPABASE_ANON_KEY=YOUR_ANON_KEY

# ── Stripe ───────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Web Push (VAPID) ─────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY
VAPID_EMAIL=mailto:security@jobfasthq.com

# ── AI / OpenAI (optional — enables OCR & AI file analysis) ──
OPENAI_API_KEY=sk-...

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=200

# ── Monitoring / Observability ────────────────────────────────
SENTRY_DSN=https://...@sentry.io/...

# ── Admin ────────────────────────────────────────────────────
ADMIN_EMAILS=admin@jobfasthq.com